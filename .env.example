# ==============================================================================
# HỆ THỐNG QUẢN LÝ KHO QKSHOP - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Hướng dẫn: Sao chép file này thành .env và chỉnh sửa giá trị phù hợp với hệ thống
# LƯU Ý: Tuyệt đối không commit file .env (chứa mật khẩu thật) lên Git!
# ==============================================================================

# --- [CẤU HÌNH MẠNG & CỔNG TRUY CẬP] ---
# BIND_IP: 0.0.0.0 lắng nghe trên toàn bộ card mạng (LAN, VPS IP tĩnh)
BIND_IP=0.0.0.0
# Cổng phục vụ web chính (HTTP_PORT=80 nếu chạy production, hoặc 3000/5173 khi dev)
HTTP_PORT=80
# Cổng Backend Spring Boot (Mặc định: 8080)
PORT=8080

# --- [CƠ SỞ DỮ LIỆU MYSQL] ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=qkshop_tonkho
DB_USERNAME=root
DB_PASSWORD=your_strong_mysql_password_here

# --- [BẢO MẬT XÁC THỰC JWT] ---
# Khóa bí mật HMAC-SHA256 (Tối thiểu 256 bits - chuỗi 64 ký tự hex ngẫu nhiên)
JWT_SECRET=357638792F423F4428472B4B6250655368566D597133743677397A2443264629
# Thời gian hết hạn Access Token (milliseconds - Mặc định 24 giờ = 86400000)
JWT_EXPIRATION_MS=86400000
# Thời gian hết hạn Refresh Token (milliseconds - Mặc định 7 ngày = 604800000)
JWT_REFRESH_EXPIRATION_MS=604800000

# --- [TÀI KHOẢN QUẢN TRỊ VIÊN MẶC ĐỊNH BAN ĐẦU] ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_FULLNAME=Admin QKShop
ADMIN_EMAIL=admin@qkshop.vn

# --- [TÍCH HỢP GOOGLE SHEETS SYNC (TÙY CHỌN)] ---
# Đặt file service_account.json vào thư mục backend/secrets/
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SYNC_ENABLED=false
GOOGLE_SHEETS_CRON=0 */30 * * * *
