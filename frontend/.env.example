# ==========================================
# Cấu hình Frontend (React / Vite)
# ==========================================

# (Dành cho môi trường dev) URL backend mà Vite sẽ proxy tới
# Mặc định là http://localhost:8080 nếu không set
VITE_API_PROXY_TARGET=http://localhost:8080

# (Dành cho môi trường production hoặc khi không dùng proxy)
# Nếu bạn deploy frontend và backend ở 2 domain khác nhau, hãy set biến này.
# Nếu dùng Nginx proxy cùng domain, có thể để trống hoặc set là /api
# VITE_API_BASE_URL=https://api.ten-mien-cua-ban.com/api
VITE_API_BASE_URL=/api
